---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form role="search" class="mb-6" data-testid="game-search-form">
            <label for="game-search" class="block text-sm font-medium text-slate-200 mb-2">
              Search games by title
            </label>
            <input
              id="game-search"
              name="search"
              type="search"
              placeholder="Search by game title"
              autocomplete="off"
              class="w-full rounded-lg border border-slate-600 bg-slate-800 px-4 py-3 text-slate-100 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="game-search-input"
            />
          </form>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <p class="sr-only" data-testid="search-results-status" role="status" aria-live="polite"></p>

          <div data-testid="search-empty-state" hidden>
            <EmptyState text="No games match your search." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const searchForm = document.querySelector<HTMLFormElement>('[data-testid="game-search-form"]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-testid="game-search-input"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const emptyState = document.querySelector<HTMLElement>('[data-testid="search-empty-state"]');
  const resultsStatus = document.querySelector<HTMLElement>('[data-testid="search-results-status"]');

  const updateSearchResults = (): void => {
    const query = searchInput?.value.trim().toLocaleLowerCase() ?? '';
    let visibleGames = 0;

    for (const card of gameCards) {
      const title = card.dataset.gameTitle?.toLocaleLowerCase() ?? '';
      const matches = title.includes(query);
      card.hidden = !matches;
      if (matches) {
        visibleGames += 1;
      }
    }

    if (emptyState) {
      emptyState.hidden = visibleGames !== 0;
    }
    if (resultsStatus) {
      resultsStatus.textContent =
        visibleGames === 0
          ? 'No games match your search.'
          : `${visibleGames} ${visibleGames === 1 ? 'game' : 'games'} found.`;
    }
  };

  updateSearchResults();
  searchInput?.addEventListener('input', updateSearchResults);
  searchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    updateSearchResults();
  });
</script>
